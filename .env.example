# Copy to .env. Never commit .env.
# Values below suit local Compose; the "Production" notes list what to change on a VPS.

APP_NAME=smb-support-copilot
# Set to production on the VPS. The API then refuses to start with the default JWT_SECRET and hides /docs.
APP_ENV=development

# Backing services (Compose overrides these hostnames for the api container)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks

# Production: generate with `openssl rand -hex 32`
JWT_SECRET=dev-only-change-me

# LLM and embeddings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Seconds before a model call is abandoned and the API answers 502
LLM_TIMEOUT_SECONDS=60

# Retrieval and chat behavior
CHUNK_STRATEGY=parent_child
# Gate on merge_hybrid scores; 0.3 pairs with dense weight 0.7 (single-channel undiluted,
# both-present mid-strength agreement like dense 0.4 / sparse 0.2 still clears).
RETRIEVAL_MIN_SCORE=0.3
RETRIEVAL_DENSE_WEIGHT=0.7
CHAT_HISTORY_TURNS=6
ORDER_STUB_MODE=hit

# Redis token buckets: burst size and sustained requests per minute
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_BURST=10
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_DRAFTS_BURST=10
RATE_LIMIT_DRAFTS_PER_MINUTE=30

# Production: https://your-domain (comma separated list of browser origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# n8n draft-reply workflow
N8N_DRAFT_SECRET=replace-with-a-random-shared-secret
DRAFT_USER_EMAIL=knowledge-owner@example.com

# Compose Postgres. Production: use a strong POSTGRES_PASSWORD.
POSTGRES_DB=copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Production only: public hostname served by Nginx and covered by the Let's Encrypt certificate
DOMAIN=copilot.example.com
# Production only: email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Not read by the API. Listed here so operators know every variable in the repo.
# ---------------------------------------------------------------------------

# n8n process (n8n/workflows/draft-reply.json). N8N_DRAFT_SECRET above must match the API value.
# DRAFT_API_URL: http://api:8000 if n8n joins the Compose network, otherwise https://<DOMAIN>/api
# DRAFT_API_URL=http://api:8000
# SLACK_WEBHOOK_URL: Slack incoming webhook for the draft approval channel
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me

# Expo mobile client: set in mobile/.env.local, inlined at bundle time (restart with `npx expo start -c`).
# Phone on LAN: http://<your-lan-ip>:8000. Production: https://<DOMAIN>/api
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Vite admin UI: build-time only. Leave unset to call the same-origin /api (default, works behind Nginx).
# VITE_API_URL=https://<DOMAIN>/api
